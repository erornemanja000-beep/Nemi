// Cloudflare Workers Builds runs `npx wrangler deploy` in the root of the gh-pages branch
{
  "name": "nemistudio-site",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./nemistudio",
    "binding": "ASSETS",
    "run_worker_first": ["/v/*"]
  }
}
