# Isto kao NPM_FLAGS u netlify.toml, ali i lokalno: paketi se instaliraju bez install skripti (CLAUDE.md, bezbednost Z16).
# `npm run <skripta>` i dalje radi; ne rade samo pre/post skripte i install skripte paketa.
ignore-scripts=true
# nove zavisnosti se upisuju tačnom verzijom (bez ^), kao ostale u package.json
save-exact=true
